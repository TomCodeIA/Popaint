-- Locale.get("fr", "ResetIn", { zone = "Candy Meadow", time = "0:27" })
function Locale.get(lang: string, key: string, vars: { [string]: any }?): string
	local tbl = STRINGS[lang] or STRINGS.en
	local text = tbl[key] or STRINGS.en[key] or key
	if vars then
		text = string.gsub(text, "{(%w+)}", function(name: string): string
			local v = vars[name]
			return if v ~= nil then tostring(v) else "{" .. name .. "}"
		end)
	end
	return text
end

function Locale.isValid(lang: any): boolean
	return type(lang) == "string" and STRINGS[lang] ~= nil
end

return Locale
